generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  CUSTOMER
  NOT_INTERESTED
}

enum OwnershipStatus {
  ACTIVE
  RELEASED
}

enum TaskStatus {
  TODO
  DONE
  CANCELLED
}

enum ConsultationCallStatus {
  NOT_REACHED
  CALLED
}

enum MessageStatus {
  SENT
  NOT_SENT
}

model User {
  id                 String                @id @default(uuid())
  name               String
  username           String?               @unique
  email              String                @unique
  phone              String?
  employeeCode       String?               @map("employee_code")
  department         String?
  positionTitle      String?               @map("position_title")
  dateOfBirth        DateTime?             @map("date_of_birth") @db.Date
  gender             String?
  citizenId          String?               @map("citizen_id")
  citizenIssuedDate  DateTime?             @map("citizen_issued_date") @db.Date
  citizenIssuedPlace String?               @map("citizen_issued_place")
  currentAddress     String?               @map("current_address")
  hometown           String?
  emergencyContactName String?             @map("emergency_contact_name")
  emergencyContactPhone String?            @map("emergency_contact_phone")
  startDate          DateTime?             @map("start_date") @db.Date
  personalNote       String?               @map("personal_note")
  bankAccountNumber  String?               @map("bank_account_number")
  bankName           String?               @map("bank_name")
  bankAccountHolder  String?               @map("bank_account_holder")
  passwordHash       String                @map("password_hash")
  role               UserRole              @default(STAFF)
  status             UserStatus            @default(ACTIVE)
  createdAt          DateTime              @default(now()) @map("created_at")
  deletedAt          DateTime?             @map("deleted_at")
  ownedCustomers     Customer[]            @relation("CustomerOwner")
  ownerships         CustomerOwnership[]
  interactions       CustomerInteraction[]
  tasks              Task[]
  createdImports     ImportHistory[]       @relation("ImportCreatedBy")
  weeklySchedules    WeeklyWorkSchedule[]

  @@index([deletedAt])
  @@map("users")
}

model Customer {
  id           String                @id @default(uuid())
  name         String
  companyHead  String?               @map("company_head")
  phone        String?               @unique
  email        String?               @unique
  address      String?
  city         String?
  source       String?
  status       CustomerStatus        @default(NEW)
  revenue      Decimal               @default(0) @db.Decimal(14, 2)
  ownerId      String?               @map("owner_id")
  importId     String?               @map("import_id")
  owner        User?                 @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  importHistory ImportHistory?       @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  ownerships   CustomerOwnership[]
  interactions CustomerInteraction[]
  tasks        Task[]

  @@index([status])
  @@index([ownerId])
  @@index([importId])
  @@index([city])
  @@map("customers")
}

model CustomerOwnership {
  id           String          @id @default(uuid())
  customerId   String          @map("customer_id")
  userId       String          @map("user_id")
  assignedDate DateTime        @default(now()) @map("assigned_date")
  releasedDate DateTime?       @map("released_date")
  status       OwnershipStatus @default(ACTIVE)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@index([userId, status])
  @@map("customer_ownerships")
}

model CustomerInteraction {
  id              String                  @id @default(uuid())
  customerId      String                  @map("customer_id")
  userId          String                  @map("user_id")
  note            String
  result          String?
  callStatus      ConsultationCallStatus? @map("call_status")
  messageStatus   MessageStatus?          @map("message_status")
  noMessageReason String?                 @map("no_message_reason")
  callHistoryImage String?                 @map("call_history_image")
  createdAt       DateTime                @default(now()) @map("created_at")
  customer        Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@map("customer_interactions")
}

model Task {
  id         String     @id @default(uuid())
  customerId String     @map("customer_id")
  userId     String     @map("user_id")
  title      String
  deadline   DateTime
  status     TaskStatus @default(TODO)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deadline])
  @@index([customerId])
  @@map("tasks")
}

model ImportHistory {
  id            String   @id @default(uuid())
  importName    String?  @map("import_name")
  filename      String
  totalRows     Int      @map("total_rows")
  successRows   Int      @map("success_rows")
  duplicateRows Int      @map("duplicate_rows")
  failedRows    Int      @default(0) @map("failed_rows")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  creator       User?    @relation("ImportCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  customers     Customer[]

  @@index([createdAt])
  @@map("import_history")
}

model WeeklyWorkSchedule {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  weekStart      DateTime @map("week_start") @db.Date
  mondayStart    String?  @map("monday_start")
  mondayEnd      String?  @map("monday_end")
  tuesdayStart   String?  @map("tuesday_start")
  tuesdayEnd     String?  @map("tuesday_end")
  wednesdayStart String?  @map("wednesday_start")
  wednesdayEnd   String?  @map("wednesday_end")
  thursdayStart  String?  @map("thursday_start")
  thursdayEnd    String?  @map("thursday_end")
  fridayStart    String?  @map("friday_start")
  fridayEnd      String?  @map("friday_end")
  saturdayStart  String?  @map("saturday_start")
  saturdayEnd    String?  @map("saturday_end")
  sundayStart    String?  @map("sunday_start")
  sundayEnd      String?  @map("sunday_end")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([weekStart])
  @@map("weekly_work_schedules")
}
